# ===== Server =====
PORT=8080
NODE_ENV=development

# ===== Machine identity (สำคัญตอนมีหลายตู้) =====
# ตู้แต่ละเครื่อง .env ของตัวเอง ตั้งให้ไม่ซ้ำ
# ตัวอย่าง: BRANCH_NAME=สาขา A, MACHINE_NAME=ตู้ 1
BRANCH_NAME=default
MACHINE_NAME=machine-01
# MACHINE_ID = UUID เฉพาะตัวของตู้ (ห้ามซ้ำในจักรวาล)
# ปล่อยว่าง → server gen ให้อัตโนมัติครั้งแรก save ที่ data/machine-id
# ถ้าจะ override ให้ใส่ UUID (e.g. node -e "console.log(crypto.randomUUID())")
MACHINE_ID=

# ===== ESP32 transport =====
# mode: "mock" (in-process) | "serial" (USB to real ESP32)
ESP32_MODE=mock
ESP32_PORT=/dev/ttyUSB0
ESP32_BAUD=115200

# ===== Business rules =====
COIN_VALUE_BAHT=10
BILL_TIMEOUT_MS=2000
LOW_COIN_THRESHOLD=100

# ===== Admin =====
# default: "admin" / "changeme" ตอนแรก — ต้องเปลี่ยนก่อน production
ADMIN_USERNAME=admin
# bcryptjs hash ของ "changeme" — gen ใหม่ด้วย: node -e "console.log(require('bcryptjs').hashSync('your-pw', 10))"
ADMIN_PASSWORD_HASH=$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy
# random secret สำหรับ session cookie (gen ใหม่: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace-this-with-random-64-char-hex-string-from-the-command-above

# ===== Discord =====
# webhook URL จาก Discord channel settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
DISCORD_DAILY_SUMMARY_HOUR=23

# ===== Database =====
DB_PATH=./data/coin.db
